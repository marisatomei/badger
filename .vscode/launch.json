{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Validate Badge Apps",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/badge.py",
            "args": [
                "validate"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "presentation": {
                "hidden": false,
                "group": "badge",
                "order": 1
            }
        },
        {
            "name": "2025 Simulator (Current File)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/badge25/simulator/badge_simulator.py",
            "args": [
                "${fileDirname}"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/badge25"
            },
            "justMyCode": false,
            "presentation": {
                "hidden": false,
                "group": "simulator",
                "order": 1
            }
        },
